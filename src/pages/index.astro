---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Akash Nagapure | Microsoft Intune, SCCM & VMware Architect Portfolio">

<!-- Navigation Header -->
<header class="fixed top-0 w-full z-50 bg-slate-950/70 backdrop-blur-xl border-b border-sky-500/20 shadow-[0_10px_30px_rgba(0,0,0,0.8)]">
  <div class="w-full overflow-hidden py-1.5 bg-black/40 border-b border-white/5">
    <div class="animate-scroll whitespace-nowrap">
      <span class="text-[10px] font-mono tracking-wider">
        <span class="text-amber-400 mx-3">⚡</span> 
        <span class="bg-gradient-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent font-bold">
          System Core Operational: Managing secure cloud architectures and zero-trust endpoint frameworks.
        </span>
        <a href="Sub_Pages/Projects.html" class="ml-4 text-sky-400 hover:text-white underline underline-offset-4 transition-colors">
          Explore engineering transmission logs →
        </a>
      </span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <a href="#home" class="flex items-center space-x-3 group cursor-pointer" onclick="scrollToSection(event, 'home')">
        <div class="h-9 w-9 flex items-center justify-center rounded-lg bg-sky-950/50 border border-sky-500/40 p-1 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
          <img src="/Main_page_data/Logo.avif" alt="Logo" width="32" height="32" class="h-full w-auto object-contain" onerror="this.onerror=null; this.src='/Main_page_data/placeholder.gif';" />
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-sm text-white tracking-tight leading-none">Akash Nagapure</span>
          <span class="font-mono text-[9px] text-sky-400 font-semibold tracking-widest mt-1">FLEET ARCHITECT</span>
        </div>
      </a>

      <!-- Desktop Nav Menu -->
      <div class="hidden lg:flex items-center space-x-1 font-mono text-xs" id="nav-menu">
        <a href="#about" class="nav-item-link px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/40 border border-transparent transition-all" onclick="scrollToSection(event, 'about')">About</a>
        <a href="#certifications" class="nav-item-link px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/40 border border-transparent transition-all" onclick="scrollToSection(event, 'certifications')">Certifications</a>
        <a href="#education" class="nav-item-link px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/40 border border-transparent transition-all" onclick="scrollToSection(event, 'education')">Education</a>
        <a href="#hobbies" class="nav-item-link px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/40 border border-transparent transition-all" onclick="scrollToSection(event, 'hobbies')">Hobbies</a>
        <a href="#projects" class="nav-item-link px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/40 border border-transparent transition-all" onclick="scrollToSection(event, 'projects')">Projects</a>
        <a href="#contact" class="nav-item-link px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/40 border border-transparent transition-all" onclick="scrollToSection(event, 'contact')">Contact</a>
      </div>

      <div class="flex items-center lg:hidden">
        <button id="mobile-menu-btn" onclick="toggleMobileMenu()" class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none">
          <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden bg-slate-950/95 border-b border-white/10 backdrop-blur-2xl px-4 pt-3 pb-6 space-y-1 font-mono text-xs">
    <a href="#about" class="block w-full px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-900" onclick="scrollToSection(event, 'about')">About</a>
    <a href="#certifications" class="block w-full px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-900" onclick="scrollToSection(event, 'certifications')">Certifications</a>
    <a href="#education" class="block w-full px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-900" onclick="scrollToSection(event, 'education')">Education</a>
    <a href="#hobbies" class="block w-full px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-900" onclick="scrollToSection(event, 'hobbies')">Hobbies</a>
    <a href="#projects" class="block w-full px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-900" onclick="scrollToSection(event, 'projects')">Projects</a>
    <a href="#contact" class="block w-full px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-900" onclick="scrollToSection(event, 'contact')">Contact</a>
  </div>
</header>

<main class="flex-grow pt-14">
  
  <!-- Hero Section -->
  <section id="home" class="min-h-screen flex items-center justify-center py-20 relative scroll-mt-20">
    <div class="absolute top-1/4 right-[15%] w-96 h-96 rounded-full bg-sky-500/10 blur-[140px] pointer-events-none animate-pulse"></div>
    <div class="absolute bottom-1/4 left-[10%] w-80 h-80 rounded-full bg-indigo-500/10 blur-[120px] pointer-events-none animate-pulse"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 flex flex-col items-start space-y-6 text-left">
          <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-slate-900/60 border border-emerald-500/35 shadow-lg">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="font-mono text-[11px] font-bold text-emerald-400 tracking-wider uppercase">
              AVAILABLE FOR WORK
            </span>
          </div>

          <div class="space-y-3">
            <h1 class="font-sans text-5xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-none drop-shadow-md">
              Akash Nagapure
            </h1>
            <p class="font-mono text-base sm:text-lg font-semibold text-sky-400 tracking-wide">
              Microsoft Intune &amp; VMware Architect | Endpoint Security Specialist
            </p>
          </div>

          <p class="max-w-xl font-sans text-slate-300 text-base sm:text-lg leading-relaxed">
            Optimizing Modern Endpoints with Precision, Security, and Virtualization Expertise. Certified IT Professional specializing in Microsoft Intune, Microsoft Endpoint Manager, SCCM, VMware, and cloud-native infrastructure automation.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto pt-2">
            <a href="Sub_Pages/resume.html" class="inline-flex items-center justify-center space-x-2 px-6 py-3.5 bg-gradient-to-r from-sky-400 to-sky-500 hover:from-sky-300 hover:to-sky-400 text-slate-950 font-sans font-bold rounded-xl shadow-lg shadow-sky-500/20 hover:-translate-y-0.5 transition-all">
              <i data-lucide="file-text" class="w-5 h-5"></i>
              <span>Resume</span>
            </a>

            <a href="Sub_Pages/Projects.html" class="inline-flex items-center justify-center space-x-2 px-6 py-3.5 cyber-panel text-white font-sans font-semibold rounded-xl hover:bg-slate-900/60 hover:-translate-y-0.5 transition-all">
              <i data-lucide="book-open" class="w-5 h-5 text-sky-400"></i>
              <span>Technical Blogs</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center relative">
          <div class="relative group">
            <div class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-500 opacity-20 group-hover:opacity-50 blur-xl transition duration-500"></div>

            <div class="relative cyber-panel rounded-2xl p-4 shadow-2xl">
              <img
                src="/Main_page_data/akash_profile_1781110763642.avif"
                alt="Akash Nagapure portrait photography"
                width="380"
                height="380"
                fetchpriority="high"
                class="w-[300px] sm:w-[340px] lg:w-[380px] h-auto rounded-xl grayscale hover:grayscale-0 transition-all duration-500 object-cover aspect-square shadow-inner"
                onerror="this.onerror=null; this.src='/Main_page_data/placeholder.gif';"
                referrerpolicy="no-referrer"
              />
            </div>

            <div class="absolute bottom-6 right-4 sm:-right-4 cyber-panel rounded-xl p-3.5 shadow-2xl max-w-[210px] flex items-center space-x-3.5">
              <div class="p-2.5 bg-sky-950/50 rounded-lg border border-sky-400/30 text-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
                <i data-lucide="cloud" class="w-5 h-5 animate-pulse"></i>
              </div>
              <div class="flex flex-col text-left">
                <span class="font-sans font-black text-white text-lg tracking-tight leading-none">35000+</span>
                <span class="font-mono text-[9px] text-sky-400 font-semibold uppercase tracking-wider mt-1">Endpoints Managed</span>
              </div>
            </div>

            <div class="absolute -top-4 -left-4 cyber-panel rounded-xl px-3 py-2 shadow-lg hidden sm:flex items-center space-x-2">
              <i data-lucide="cpu" class="w-4 h-4 text-indigo-400"></i>
              <span class="font-mono text-[10px] text-slate-200 font-medium">Modern Workplace Architect</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- About Me Section -->
  <section id="about" class="py-24 text-left relative scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex items-center space-x-4 mb-12">
        <div class="w-1.5 h-10 bg-gradient-to-b from-sky-400 to-sky-600 rounded-full shadow-[0_0_10px_rgba(56,189,248,0.6)]"></div>
        <h2 class="font-sans text-3xl sm:text-4xl font-black text-white tracking-tight">About Me</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 space-y-6">
          <h3 class="font-sans text-xl sm:text-2xl font-bold text-sky-300 tracking-tight leading-relaxed">
            Architect Behind The Screens
          </h3>
          <p class="font-sans text-slate-300 text-base sm:text-lg leading-relaxed">
            I design automated, secure, and bulletproof device environments. I approach enterprise infrastructure through an engineering lens—treating client fleet configuration as a craft and zero-trust security as a baseline.
          </p>
          <p class="font-sans text-slate-300 text-base sm:text-lg leading-relaxed">
            Outside of managing 35k+ endpoints, I am simply a builder who loves structured systems. Offline, I keep my mind sharp by breaking things in my self-hosted homelab, mastering strategic gaming or decoding history through numismatics (rare coins).
          </p>

          <div class="flex flex-wrap gap-4 pt-4">
            <a href="Sub_Pages/Skills.html" class="inline-flex items-center space-x-2 px-6 py-3.5 cyber-panel hover:bg-slate-900/60 border border-sky-400/40 text-sky-300 font-mono text-xs uppercase font-bold rounded-xl shadow-lg transition-all hover:scale-105">
              <i data-lucide="cpu" class="w-4 h-4"></i>
              <span>View Skills →</span>
            </a>
            <a href="Sub_Pages/courses.html" class="inline-flex items-center space-x-2 px-6 py-3.5 cyber-panel hover:bg-slate-900/60 border border-indigo-400/40 text-indigo-300 font-mono text-xs uppercase font-bold rounded-xl shadow-lg transition-all hover:scale-105">
              <i data-lucide="award" class="w-4 h-4"></i>
              <span>View Courses Completed →</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="cyber-panel p-6 rounded-2xl group relative flex flex-col justify-between min-h-[170px] holo-glow">
            <div class="flex items-center justify-between mb-4"><i data-lucide="briefcase" class="w-6 h-6 text-sky-400"></i><span class="font-mono text-[10px] text-sky-400/80 font-bold uppercase tracking-widest">Metric</span></div>
            <div class="space-y-1 mt-auto">
              <div class="font-sans font-black text-3xl sm:text-4xl text-sky-400 tracking-tight"><span class="metric-value" data-target="10">0</span>+</div>
              <div class="font-mono text-[11px] text-slate-300 font-bold uppercase tracking-wider block">YEARS EXPERIENCE</div>
            </div>
          </div>
          <div class="cyber-panel p-6 rounded-2xl group relative flex flex-col justify-between min-h-[170px] holo-glow">
            <div class="flex items-center justify-between mb-4"><i data-lucide="refresh-cw" class="w-6 h-6 text-sky-400"></i><span class="font-mono text-[10px] text-sky-400/80 font-bold uppercase tracking-widest">Metric</span></div>
            <div class="space-y-1 mt-auto">
              <div class="font-sans font-black text-3xl sm:text-4xl text-sky-400 tracking-tight"><span class="metric-value" data-target="15">0</span>+</div>
              <div class="font-mono text-[11px] text-slate-300 font-bold uppercase tracking-wider block">LARGE MIGRATIONS</div>
            </div>
          </div>
          <div class="cyber-panel p-6 rounded-2xl group relative flex flex-col justify-between min-h-[170px] holo-glow">
            <div class="flex items-center justify-between mb-4"><i data-lucide="award" class="w-6 h-6 text-sky-400"></i><span class="font-mono text-[10px] text-sky-400/80 font-bold uppercase tracking-widest">Metric</span></div>
            <div class="space-y-1 mt-auto">
              <div class="font-sans font-black text-3xl sm:text-4xl text-sky-400 tracking-tight"><span class="metric-value" data-target="10">0</span>+</div>
              <div class="font-mono text-[11px] text-slate-300 font-bold uppercase tracking-wider block">CLOUD CERTS</div>
            </div>
          </div>
          <div class="cyber-panel p-6 rounded-2xl group relative flex flex-col justify-between min-h-[170px] holo-glow">
            <div class="flex items-center justify-between mb-4"><i data-lucide="activity" class="w-6 h-6 text-sky-400"></i><span class="font-mono text-[10px] text-sky-400/80 font-bold uppercase tracking-widest">Metric</span></div>
            <div class="space-y-1 mt-auto">
              <div class="font-sans font-black text-3xl sm:text-4xl text-sky-400 tracking-tight"><span class="metric-value" data-target="99">0</span>%</div>
              <div class="font-mono text-[11px] text-slate-300 font-bold uppercase tracking-wider block">UPTIME FOCUS</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Professional Certifications Section -->
  <section id="certifications" class="py-24 border-y border-sky-500/20 text-center relative scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto mb-16 text-center">
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 cyber-panel border border-sky-500/30 rounded-full mb-4 shadow-[0_0_15px_rgba(56,189,248,0.2)]">
          <i data-lucide="award" class="w-4 h-4 text-sky-400"></i>
          <span class="font-mono text-xs text-sky-400 font-bold uppercase tracking-wider">Credentials</span>
        </div>
        <h2 class="font-sans text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">Professional Certifications</h2>
        <p class="font-sans text-slate-400 text-base sm:text-lg">Validated expertise across the Microsoft cloud and endpoint management spectrum. (Click cards to reveal specifics)</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 justify-center">
        <!-- Cert 1 -->
        <div class="flip-card-container h-[240px] cursor-pointer" onclick="this.classList.toggle('is-flipped')">
          <div class="flip-card-inner w-full h-full">
            <div class="flip-card-front cyber-panel p-6 rounded-xl flex flex-col items-center justify-between text-center h-full">
              <div class="w-14 h-14 rounded-xl bg-sky-950/60 border border-sky-400/30 flex items-center justify-center text-sky-400">
                <i data-lucide="shield" class="w-7 h-7"></i>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-white text-base">MD-102</h3>
                <p class="font-mono text-[10px] text-sky-400 uppercase">Endpoint Admin</p>
              </div>
              <div class="px-2.5 py-1 bg-black/40 border border-sky-500/30 rounded font-mono text-[10px] text-sky-300">Verified</div>
            </div>
            <div class="flip-card-back cyber-panel border border-sky-400 p-6 rounded-xl flex flex-col items-center justify-center text-center h-full">
              <i data-lucide="award" class="w-8 h-8 text-sky-400 mb-2"></i>
              <h4 class="font-bold text-white text-xs mb-1">MD-102 Verification</h4>
              <p class="text-slate-300 text-[11px] leading-relaxed">Validates advanced skills in deploying operating systems, managing apps, and implementing configuration profiles.</p>
            </div>
          </div>
        </div>

        <!-- Cert 2 -->
        <div class="flip-card-container h-[240px] cursor-pointer" onclick="this.classList.toggle('is-flipped')">
          <div class="flip-card-inner w-full h-full">
            <div class="flip-card-front cyber-panel p-6 rounded-xl flex flex-col items-center justify-between text-center h-full">
              <div class="w-14 h-14 rounded-xl bg-sky-950/60 border border-sky-400/30 flex items-center justify-center text-sky-400">
                <i data-lucide="tablet" class="w-7 h-7"></i>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-white text-base">ITIL 4</h3>
                <p class="font-mono text-[10px] text-sky-400 uppercase">Foundation</p>
              </div>
              <div class="px-2.5 py-1 bg-black/40 border border-sky-500/30 rounded font-mono text-[10px] text-sky-300">Verified</div>
            </div>
            <div class="flip-card-back cyber-panel border border-sky-400 p-6 rounded-xl flex flex-col items-center justify-center text-center h-full">
              <i data-lucide="award" class="w-8 h-8 text-sky-400 mb-2"></i>
              <h4 class="font-bold text-white text-xs mb-1">ITIL V4 Blueprint</h4>
              <p class="text-slate-300 text-[11px] leading-relaxed">Leverages structural frameworks to align core digital workspace delivery with business scaling matrices.</p>
            </div>
          </div>
        </div>

        <!-- Cert 3 -->
        <div class="flip-card-container h-[240px] cursor-pointer" onclick="this.classList.toggle('is-flipped')">
          <div class="flip-card-inner w-full h-full">
            <div class="flip-card-front cyber-panel p-6 rounded-xl flex flex-col items-center justify-between text-center h-full">
              <div class="w-14 h-14 rounded-xl bg-sky-950/60 border border-sky-400/30 flex items-center justify-center text-sky-400">
                <i data-lucide="cpu" class="w-7 h-7"></i>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-white text-base">AZ-104</h3>
                <p class="font-mono text-[10px] text-sky-400 uppercase">Azure Admin</p>
              </div>
              <div class="px-2.5 py-1 bg-black/40 border border-sky-500/30 rounded font-mono text-[10px] text-sky-300">Verified</div>
            </div>
            <div class="flip-card-back cyber-panel border border-sky-400 p-6 rounded-xl flex flex-col items-center justify-center text-center h-full">
              <i data-lucide="award" class="w-8 h-8 text-sky-400 mb-2"></i>
              <h4 class="font-bold text-white text-xs mb-1">Azure Infrastructure</h4>
              <p class="text-slate-300 text-[11px] leading-relaxed">Validates capabilities managing virtual networks, cloud storage nodes, structural compute profiles, and identity governance.</p>
            </div>
          </div>
        </div>

        <!-- Cert 4 -->
        <div class="flip-card-container h-[240px] cursor-pointer" onclick="this.classList.toggle('is-flipped')">
          <div class="flip-card-inner w-full h-full">
            <div class="flip-card-front cyber-panel p-6 rounded-xl flex flex-col items-center justify-between text-center h-full">
              <div class="w-14 h-14 rounded-xl bg-sky-950/60 border border-sky-400/30 flex items-center justify-center text-sky-400">
                <i data-lucide="cloud" class="w-7 h-7"></i>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-white text-base">AZ-900</h3>
                <p class="font-mono text-[10px] text-sky-400 uppercase">Azure Fundamentals</p>
              </div>
              <div class="px-2.5 py-1 bg-black/40 border border-sky-500/30 rounded font-mono text-[10px] text-sky-300">Verified</div>
            </div>
            <div class="flip-card-back cyber-panel border border-sky-400 p-6 rounded-xl flex flex-col items-center justify-center text-center h-full">
              <i data-lucide="award" class="w-8 h-8 text-sky-400 mb-2"></i>
              <h4 class="font-bold text-white text-xs mb-1">Cloud Core Principles</h4>
              <p class="text-slate-300 text-[11px] leading-relaxed">Validates high-level understanding of cloud concepts, security matrix models, privacy protocols, and Azure frameworks.</p>
            </div>
          </div>
        </div>

        <!-- Cert 5 -->
        <div class="flip-card-container h-[240px] cursor-pointer" onclick="this.classList.toggle('is-flipped')">
          <div class="flip-card-inner w-full h-full">
            <div class="flip-card-front cyber-panel p-6 rounded-xl flex flex-col items-center justify-between text-center h-full">
              <div class="w-14 h-14 rounded-xl bg-sky-950/60 border border-sky-400/30 flex items-center justify-center text-sky-400">
                <i data-lucide="layout-grid" class="w-7 h-7"></i>
              </div>
              <div class="space-y-1">
                <h3 class="font-bold text-white text-base">MS-102</h3>
                <p class="font-mono text-[10px] text-sky-400 uppercase">M365 Admin</p>
              </div>
              <div class="px-2.5 py-1 bg-black/40 border border-sky-500/30 rounded font-mono text-[10px] text-sky-300">Verified</div>
            </div>
            <div class="flip-card-back cyber-panel border border-sky-400 p-6 rounded-xl flex flex-col items-center justify-center text-center h-full">
              <i data-lucide="award" class="w-8 h-8 text-sky-400 mb-2"></i>
              <h4 class="font-bold text-white text-xs mb-1">M365 Tenant Admin</h4>
              <p class="text-slate-300 text-[11px] leading-relaxed">Validates structural capacity evaluating, planning, and managing tenant identity services and corporate endpoints.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Education & Academy Section -->
  <section id="education" class="py-24 border-y border-sky-500/20 text-left relative scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="mb-12">
        <div class="flex items-center space-x-4 mb-3">
          <i data-lucide="graduation-cap" class="w-8 h-8 text-sky-400"></i>
          <h2 class="font-sans text-3xl sm:text-4xl font-black text-white tracking-tight">Education &amp; Academy</h2>
        </div>
