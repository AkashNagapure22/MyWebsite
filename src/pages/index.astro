<button id="back-to-top-btn" onclick="scrollToTop()" class="hidden fixed bottom-6 right-6 p-3.5 rounded-full bg-slate-900/90 border border-sky-400/40 text-sky-400 hover:text-white backdrop-blur-md shadow-[0_0_20px_rgba(56,189,248,0.3)] transition-all duration-300 z-50 cursor-pointer hover:border-sky-400 hover:scale-110" aria-label="Scroll Back To Top">
  <i data-lucide="arrow-up" class="w-5 h-5"></i>
