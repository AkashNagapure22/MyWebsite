---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page Not Found | Akash Nagapure</title>
  </head>
  <body class="fallback-page">
    <main>
      <p class="eyebrow">404 / ROUTE NOT FOUND</p>
      <h1>This page does not exist.</h1>
      <p>The requested address may have moved or never existed.</p>
      <a href="/">Return to the main hub</a>
    </main>
  </body>
</html>
<style>
  .fallback-page { min-height: 100vh; display: grid; place-items: center; padding: 2rem; text-align: center; }
  main { max-width: 38rem; } .eyebrow { color: #38bdf8; font: .75rem 'JetBrains Mono', monospace; letter-spacing: .12em; }
  h1 { color: #fff; font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1; } p { color: #cbd5e1; line-height: 1.7; }
  a { color: #38bdf8; }
</style>