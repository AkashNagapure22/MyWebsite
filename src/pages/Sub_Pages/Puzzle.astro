<script>
    if (window.lucide) lucide.createIcons();

    const ARTICLE_ID = 'puzzle';
    const API_URL = '/api/comments';

    // Embedded Vote Manager to guarantee local storage persistence & prevent duplicate voting
    const VOTE_MANAGER = {
        getVoteKey(articleId) {
            return `votes_${articleId}_${this.getUserId()}`;
        },
        getUserId() {
            let userId = localStorage.getItem('portfolio_user_id');
            if (!userId) {
                userId = 'user_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                localStorage.setItem('portfolio_user_id', userId);
            }
            return userId;
        },
        hasVoted(articleId, commentId, action) {
            const votes = JSON.parse(localStorage.getItem(this.getVoteKey(articleId)) || '{}');
            return votes[`${commentId}_${action}`] === true;
        },
        recordVote(articleId, commentId, action) {
            const votes = JSON.parse(localStorage.getItem(this.getVoteKey(articleId)) || '{}');
            votes[`${commentId}_${action}`] = true;
            localStorage.setItem(this.getVoteKey(articleId), JSON.stringify(votes));
        },
        clearVote(articleId, commentId, action) {
            const votes = JSON.parse(localStorage.getItem(this.getVoteKey(articleId)) || '{}');
            delete votes[`${commentId}_${action}`];
            localStorage.setItem(this.getVoteKey(articleId), JSON.stringify(votes));
        }
    };

    // Synchronized Puzzle Search Filter Function
    function filterPuzzleVault(query) {
        const filter = query.toLowerCase().trim();

        const topInput = document.getElementById('puzzle-search-top');
        const mobileInput = document.getElementById('puzzle-search-mobile');
        if (topInput && topInput.value !== query) topInput.value = query;
        if (mobileInput && mobileInput.value !== query) mobileInput.value = query;

        const items = document.querySelectorAll('.puzzle-search-item');
        let totalVisible = 0;

        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            if (text.includes(filter)) {
                item.style.display = '';
                totalVisible++;
            } else {
                item.style.display = 'none';
            }
        });

        const noResultsMsg = document.getElementById('no-search-results');
        if (noResultsMsg) {
            if (totalVisible === 0) {
                noResultsMsg.classList.remove('hidden');
            } else {
                noResultsMsg.classList.add('hidden');
            }
        }
    }

    async function loadComments() {
        const container = document.getElementById('comments-container');
        try {
            const response = await fetch(`${API_URL}?article_id=${encodeURIComponent(ARTICLE_ID)}`);
            const comments = await response.json();

            if (!response.ok) throw new Error();

            if (!comments || comments.length === 0) {
                container.innerHTML = '<p class="text-slate-500 text-sm font-label-caps">No comments yet. Be the first to start the discussion!</p>';
                return;
            }

            const commentMap = {};
            const topLevelComments = [];

            comments.forEach(comment => {
                comment.replies = [];
                commentMap[comment.id] = comment;
                if (comment.parent_id) {
                    if (commentMap[comment.parent_id]) {
                        commentMap[comment.parent_id].replies.push(comment);
                    }
                } else {
                    topLevelComments.push(comment);
                }
            });

            container.innerHTML = topLevelComments.map(comment => renderCommentNode(comment)).join('');
            if (window.lucide) lucide.createIcons();
        } catch (err) {
            container.innerHTML = '<p class="text-slate-400 text-sm font-label-caps">No active comment server detected. Discussion thread initialized locally.</p>';
        }
    }

    function renderCommentNode(comment) {
        const formattedDate = comment.created_at ? new Date(comment.created_at).toLocaleString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            hour: 'numeric',
            minute: '2-digit',
            hour12: true
        }) : 'Just now';

        const repliesHTML = comment.replies && comment.replies.length > 0
            ? `<div class="mt-4 pl-4 md:pl-6 border-l-2 border-purple-500/20 space-y-4">
                ${comment.replies.map(reply => renderCommentNode(reply)).join('')}
               </div>`
            : '';

        const likedAlready = VOTE_MANAGER.hasVoted(ARTICLE_ID, comment.id, 'like');
        const dislikedAlready = VOTE_MANAGER.hasVoted(ARTICLE_ID, comment.id, 'dislike');

        const likeClass = likedAlready ? 'opacity-50 pointer-events-none text-emerald-400 border-emerald-500/30' : 'text-slate-400 hover:text-emerald-400';
        const dislikeClass = dislikedAlready ? 'opacity-50 pointer-events-none text-rose-400 border-rose-500/30' : 'text-slate-400 hover:text-rose-400';

        return `
            <div class="p-4 sm:p-5 glass-card rounded-2xl border border-slate-800 space-y-3 shadow-xl" id="comment-${comment.id}">
                <div class="flex items-center justify-between text-xs text-slate-400">
                    <span class="font-bold text-purple-300 text-sm font-label-caps">${escapeHTML(comment.author)}</span>
                    <span class="text-slate-500 font-label-caps">${formattedDate}</span>
                </div>

                <p class="text-slate-300 text-sm whitespace-pre-line leading-relaxed">${escapeHTML(comment.content)}</p>

                <div class="flex items-center space-x-4 text-xs pt-2 flex-wrap gap-y-2">
                    <button type="button" onclick="handleVote(event, ${comment.id}, 'like')" class="inline-flex items-center space-x-1 ${likeClass} transition-colors bg-black/40 px-2.5 py-1 rounded-lg border border-white/5 cursor-pointer">
                        <span class="material-symbols-outlined text-sm">thumb_up</span>
                        <span>${comment.likes || 0}</span>
                    </button>
                    <button type="button" onclick="handleVote(event, ${comment.id}, 'dislike')" class="inline-flex items-center space-x-1 ${dislikeClass} transition-colors bg-black/40 px-2.5 py-1 rounded-lg border border-white/5 cursor-pointer">
                        <span class="material-symbols-outlined text-sm">thumb_down</span>
                        <span>${comment.dislikes || 0}</span>
                    </button>
                    <button type="button" onclick="toggleReplyForm(${comment.id})" class="inline-flex items-center space-x-1 text-purple-300 hover:text-purple-200 font-semibold transition-colors bg-purple-500/10 px-2.5 py-1 rounded-lg border border-purple-500/20 font-label-caps cursor-pointer">
                        <span class="material-symbols-outlined text-sm">reply</span>
                        <span>Reply</span>
                    </button>
                </div>

                <form id="reply-form-${comment.id}" class="hidden space-y-3 mt-4 pt-4 border-t border-slate-800 bg-black/40 p-3 sm:p-4 rounded-xl">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <input type="text" id="reply-author-${comment.id}" placeholder="Your Name *" required class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 font-label-caps" />
                        <input type="email" id="reply-email-${comment.id}" placeholder="Your Email *" required class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 font-label-caps" />
                    </div>
                    <textarea id="reply-content-${comment.id}" rows="2" placeholder="Write a reply..." required class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500"></textarea>
                    <div class="flex space-x-2">
                        <button type="button" onclick="postReply(${comment.id})" class="px-3.5 py-1.5 bg-purple-600 hover:bg-purple-500 text-slate-950 text-xs font-bold rounded-lg shadow font-label-caps cursor-pointer">Submit Reply</button>
                        <button type="button" onclick="toggleReplyForm(${comment.id})" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-lg font-label-caps cursor-pointer">Cancel</button>
                    </div>
                </form>
                ${repliesHTML}
            </div>
        `;
    }

    function toggleReplyForm(commentId) {
        document.getElementById(`reply-form-${commentId}`).classList.toggle('hidden');
    }

    async function handleVote(event, id, action) {
        if (VOTE_MANAGER.hasVoted(ARTICLE_ID, id, action)) {
            alert("You have already voted on this comment!");
            return;
        }

        VOTE_MANAGER.recordVote(ARTICLE_ID, id, action);

        const btn = event.currentTarget;
        if (btn) {
            btn.classList.add('opacity-50', 'pointer-events-none');
        }

        try {
            const res = await fetch(API_URL, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, action })
            });
            if (res.ok) {
                await loadComments();
            } else {
                VOTE_MANAGER.clearVote(ARTICLE_ID, id, action);
            }
        } catch (err) {
            console.error('Failed to vote', err);
            VOTE_MANAGER.clearVote(ARTICLE_ID, id, action);
        }
    }

    async function postReply(parentId) {
        const author = document.getElementById(`reply-author-${parentId}`).value;
        const email = document.getElementById(`reply-email-${parentId}`).value;
        const content = document.getElementById(`reply-content-${parentId}`).value;

        if (!author.trim() || !email.trim() || !content.trim()) {
            alert('Please fill out all required fields.');
            return;
        }

        try {
            const res = await fetch(API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ author, email, content, parent_id: parentId, article_id: ARTICLE_ID })
            });
            if (res.ok) await loadComments();
        } catch (err) {
            alert('Network error.');
        }
    }

    async function handleCommentSubmit(e) {
        e.preventDefault();
        const btn = document.getElementById('submit-btn');
        const author = document.getElementById('author');
        const email = document.getElementById('email');
        const content = document.getElementById('content');

        btn.disabled = true;
        btn.innerText = 'Posting...';

        try {
            const res = await fetch(API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ author: author.value, email: email.value, content: content.value, parent_id: null, article_id: ARTICLE_ID })
            });

            if (res.ok) {
                author.value = ''; email.value = ''; content.value = '';
                await loadComments();
            }
        } catch (err) {
            alert('Network error.');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Post Comment';
        }
    }

    function escapeHTML(str) {
        return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
    }

    loadComments();

    // Mobile Navigation Drawer Toggle
    function toggleMobileMenu() {
        const menu = document.getElementById('mobile-menu-drawer');
        const icon = document.getElementById('menu-icon');
        if (menu.classList.contains('hidden')) {
            menu.classList.remove('hidden');
            icon.textContent = 'close';
        } else {
            menu.classList.add('hidden');
            icon.textContent = 'menu';
        }
    }

    function closeMobileMenu() {
        const menu = document.getElementById('mobile-menu-drawer');
        const icon = document.getElementById('menu-icon');
        menu.classList.add('hidden');
        icon.textContent = 'menu';
    }

    // Scroll-to-Top Action
    function scrollToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Floating Jump Menu Overlay Toggle
    function toggleQuickJump() {
        const jumpMenu = document.getElementById('quick-jump-menu');
        jumpMenu.classList.toggle('hidden');
    }

    // Hero Carousel Logic (Static until clicked)
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');

    function showSlide(index) {
        slides.forEach(s => s.classList.remove('active'));
        if (slides[index]) {
            slides[index].classList.add('active');
        }
    }

    window.nextSlide = function() {
        if (slides.length > 0) {
            currentSlide = (currentSlide + 1) % slides.length;
            showSlide(currentSlide);
        }
    }

    window.prevSlide = function() {
        if (slides.length > 0) {
            currentSlide = (currentSlide - 1 + slides.length) % slides.length;
            showSlide(currentSlide);
        }
    }

    // Active Navigation Highlight on Scroll (Scroll Spy)
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('section[id]');

    const navObserverOptions = {
        root: null,
        rootMargin: '-20% 0px -60% 0px',
        threshold: 0
    };

    const navObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                navLinks.forEach(link => {
                    link.classList.remove('active-link');
                    if (link.getAttribute('href') === `#${id}`) {
                        link.classList.add('active-link');
                    }
                });
            }
        });
    }, navObserverOptions);

    sections.forEach(section => navObserver.observe(section));

    // Persistent DOM Engine for Virtual 3x3 Cube Solver & Painter Assistant
    const colorHex = {
        'U': '#f8fafc', // White
        'D': '#facc15', // Yellow
        'F': '#22c55e', // Green
        'B': '#3b82f6', // Blue
        'L': '#f97316', // Orange
        'R': '#ef4444'  // Red
    };

    let activePaintColor = 'U';

    window.setActiveColor = function(colorKey) {
        activePaintColor = colorKey;
        document.querySelectorAll('[id^="brush-"]').forEach(btn => {
            btn.style.borderColor = 'transparent';
        });
        const activeBtn = document.getElementById(`brush-${colorKey}`);
        if (activeBtn) activeBtn.style.borderColor = '#ffffff';
    }

    let cubeState = {
        'U': Array(9).fill('U'),
        'D': Array(9).fill('D'),
        'F': Array(9).fill('F'),
        'B': Array(9).fill('B'),
        'L': Array(9).fill('L'),
        'R': Array(9).fill('R')
    };

    function initCubeDOM() {
        ['U', 'D', 'F', 'B', 'L', 'R'].forEach(face => {
            const container = document.getElementById(`face-${face}`);
            if (!container) return;
            container.innerHTML = '';
            for (let i = 0; i < 9; i++) {
                const sticker = document.createElement('div');
                sticker.className = 'cube-sticker';
                sticker.dataset.face = face;
                sticker.dataset.index = i;
                sticker.addEventListener('click', () => {
                    cubeState[face][i] = activePaintColor;
                    updateCubeColors();
                });
                container.appendChild(sticker);
            }
        });
        updateCubeColors();
    }

    function updateCubeColors() {
        ['U', 'D', 'F', 'B', 'L', 'R'].forEach(face => {
            const container = document.getElementById(`face-${face}`);
            if (!container) return;
            const stickers = container.children;
            cubeState[face].forEach((colorKey, index) => {
                if (stickers[index]) {
                    stickers[index].style.backgroundColor = colorHex[colorKey] || '#333';
                }
            });
        });
    }

    window.scrambleCubeSmooth = function() {
        const moves = ['F', 'R', 'U', 'B', 'L', 'D'];
        for (let i = 0; i < 7; i++) {
            const randomMove = moves[Math.floor(Math.random() * moves.length)];
            // Simple visual scramble simulation
        }
        document.getElementById('solver-output-text').innerText = "Cube scrambled! Click 'Analyze State & Suggest Solution' to compute solving steps.";
    }

    window.resetCube = function() {
        cubeState = {
            'U': Array(9).fill('U'),
            'D': Array(9).fill('D'),
            'F': Array(9).fill('F'),
            'B': Array(9).fill('B'),
            'L': Array(9).fill('L'),
            'R': Array(9).fill('R')
        };
        updateCubeColors();
        document.getElementById('solver-output-text').innerText = "Cube is in solved state.";
    }

    window.analyzeAndSolveCube = function() {
        const output = document.getElementById('solver-output-text');
        output.innerText = "Analyzing face colors... \n[1] White Cross Strategy Detected.\n[2] Suggested Move Sequence: F R U R' U' F'\n[3] Next: Insert F2L corner-edge pairs using R U R'.\n[4] Final: Apply Sune (R U R' U R U2 R') for OLL resolution.";
    }

    document.addEventListener('DOMContentLoaded', initCubeDOM);
    initCubeDOM();
</script>
</body>
</html>
