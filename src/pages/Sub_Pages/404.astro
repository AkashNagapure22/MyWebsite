<!DOCTYPE html>
<html class="dark scroll-smooth" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>404 - Page Not Found | Akash Nagapure</title>
<meta name="robots" content="noindex, follow" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Geist:wght@700;800&amp;family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
    .glass-card-3d {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(2, 6, 23, 0.95) 100%);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(56, 189, 248, 0.18);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9), inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
    }
</style>
</head>
<body class="bg-[#020617] text-slate-100 min-h-screen flex flex-col justify-between font-sans selection:bg-sky-500 selection:text-slate-950">
<canvas id="three-bg-canvas" class="fixed inset-0 w-full h-full -z-10 pointer-events-none"></canvas>

<!-- Top Branding Bar -->
<header class="w-full z-50 bg-slate-950/90 backdrop-blur-xl border-b border-sky-500/20 py-4 px-6 flex items-center justify-between">
    <a href="../../index.html" class="flex items-center space-x-2">
        <span class="font-sans font-bold text-white text-base">Akash Nagapure</span>
        <span class="text-sky-400 font-mono text-[10px] hidden sm:inline">| Microsoft Intune & VMware Architect</span>
    </a>
    <a href="../../index.html" class="text-xs font-mono text-sky-400 hover:underline flex items-center gap-1">← Main Hub</a>
</header>

<div class="flex-grow flex items-center justify-center px-4 py-12">
    <div class="glass-card-3d p-8 sm:p-12 rounded-3xl max-w-xl w-full text-center space-y-6 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-400 to-indigo-500"></div>
        
        <div class="w-20 h-20 bg-sky-950/80 border border-sky-400/30 rounded-2xl mx-auto flex items-center justify-center text-sky-400 shadow-[0_0_20px_rgba(56,189,248,0.3)]">
            <span class="font-mono text-3xl font-extrabold">404</span>
        </div>

        <div class="space-y-2">
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">System Route Not Found</h1>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                The targeted endpoint or resource path you are looking for does not exist or has been relocated within Akash Nagapure's enterprise architecture matrix.
            </p>
        </div>

        <div class="pt-4">
            <a href="../../index.html" class="w-full inline-flex items-center justify-center space-x-2 px-6 py-3.5 bg-gradient-to-r from-sky-400 to-sky-500 hover:from-sky-300 hover:to-sky-400 text-slate-950 font-bold rounded-xl shadow-lg transition-all text-sm font-mono">
                <span class="material-symbols-outlined text-sm">home</span>
                <span>Return to Main Hub</span>
            </a>
        </div>
    </div>
</div>

<footer class="py-6 text-center text-xs font-mono text-slate-500 border-t border-white/5 bg-slate-950">
    © 2026 Akash Nagapure. All Rights Reserved. <a href="privacy.html">Privacy</a> · <a href="terms.html">Terms</a>
</footer>

<script>
  let scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 50;
  let renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('three-bg-canvas'), alpha: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  let geom = new THREE.BufferGeometry(), count = 2000, pos = new Float32Array(count * 3);
  for(let i=0; i<count*3; i+=3) { pos[i] = (Math.random()-0.5)*400; pos[i+1] = (Math.random()-0.5)*400; pos[i+2] = (Math.random()-0.5)*200; }
  geom.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  let mesh = new THREE.Points(geom, new THREE.PointsMaterial({ color: 0x38bdf8, size: 0.8, transparent: true, opacity: 0.7 }));
  scene.add(mesh);
  function animate() { requestAnimationFrame(animate); mesh.rotation.y += 0.001; renderer.render(scene, camera); }
  animate();
</script>
</body>
</html>
