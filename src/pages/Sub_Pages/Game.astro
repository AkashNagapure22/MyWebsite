<!-- Background Shader -->
<div class="fixed inset-0 w-full h-full -z-10 bg-black overflow-hidden pointer-events-none">
    <canvas class="w-full h-full opacity-60" id="nebula-canvas"></canvas>
</div>
<script>
(function() {
    const canvas = document.getElementById('nebula-canvas');
    function syncSize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', syncSize);
    syncSize();

    const gl = canvas.getContext('webgl');
    if (!gl) return;
    const vs = `attribute vec2 a_position; varying vec2 v_texCoord; void main() { v_texCoord = a_position * 0.5 + 0.5; gl_Position = vec4(a_position, 0.0, 1.0); }`;
    const fs = `precision highp float; varying vec2 v_texCoord; uniform float u_time; uniform vec2 u_resolution; void main() { vec2 uv = v_texCoord; vec2 p = (uv * 2.0 - 1.0) * vec2(u_resolution.x / u_resolution.y, 1.0); float noise = 0.0; vec2 q = p * 0.8; for(float i = 1.0; i < 4.0; i++) { q += vec2(cos(q.y + u_time * 0.2 + i), sin(q.x + u_time * 0.15 + i)); noise += 1.0 / i * (0.5 + 0.5 * sin(length(q) + u_time * 0.1)); } vec3 color1 = vec3(0.04, 0.04, 0.06); vec3 color2 = vec3(0.02, 0.1, 0.2); vec3 color3 = vec3(0.1, 0.0, 0.2); vec3 finalColor = mix(color1, color2, noise * 0.5); finalColor = mix(finalColor, color3, clamp(length(p) * 0.3, 0.0, 1.0)); float stars = pow(sin(uv.x * 100.0) * sin(uv.y * 100.0), 20.0) * 0.05; finalColor += stars * (0.5 + 0.5 * sin(u_time * 2.0)); gl_FragColor = vec4(finalColor, 1.0); }`;
    const cs = (t, s) => { const sh = gl.createShader(t); gl.shaderSource(sh, s); gl.compileShader(sh); return sh; };
    const prog = gl.createProgram();
    gl.attachShader(prog, cs(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, cs(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog); gl.useProgram(prog);
    const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
    const pos = gl.getAttribLocation(prog, 'a_position'); gl.enableVertexAttribArray(pos);
    gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);
    const uTime = gl.getUniformLocation(prog, 'u_time');
    const uRes = gl.getUniformLocation(prog, 'u_resolution');
    function r(t) { gl.viewport(0, 0, canvas.width, canvas.height); gl.uniform1f(uTime, t * 0.001); gl.uniform2f(uRes, canvas.width, canvas.height); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); requestAnimationFrame(r); }
    r(0);
})();
</script>

